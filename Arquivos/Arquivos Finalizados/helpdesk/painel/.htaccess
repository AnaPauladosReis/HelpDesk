RewriteEngine On

# Se existir arquivo ou pasta de verdade, não reescreve (css/js/imagens)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /painel  -> /painel/index.php
RewriteRule ^$ index.php [L]

# /painel/dashboard  -> /painel/index.php?p=dashboard
RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?p=$1 [L,QSA]
